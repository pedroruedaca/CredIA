NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64: openssl rand -base64 32
CREDIA_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
# Documentation assistant model (optional; defaults to claude-opus-5-5)
CREDIA_ASSISTANT_MODEL=
# PDF extraction model (optional; defaults to claude-opus-5-5). Without ANTHROPIC_API_KEY, PDFs wait unprocessed.
CREDIA_EXTRACTION_MODEL=
# Public base URL for borrower links and for links in lender emails (recommended in production)
NEXT_PUBLIC_APP_URL=
# Email (Resend). Without a key nothing is sent (in development, messages print to the console).
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "credIA <avisos@tudominio.es>". Default: Resend's test sender,
# which only delivers to the email of your Resend account.
CREDIA_EMAIL_FROM=
# Optional reply-to address for all emails
CREDIA_EMAIL_REPLY_TO=
# Daily BORME import (Vercel Cron sends it as a bearer token): any long random string
CRON_SECRET=
